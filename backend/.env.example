PORT=8080
HOST=0.0.0.0
FRONTEND_URL=https://your-vercel-domain.vercel.app
BACKEND_URL=https://your-cloud-run-backend-url.run.app
JWT_SECRET=replace-this-with-a-long-random-secret

# Firebase Admin. Use either JSON or BASE64. BASE64 is easier for Cloud Run env vars.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Temporary testing helper until a real email provider is added.
# When true, /auth/forgot-password returns the reset link in the response.
EXPOSE_PASSWORD_RESET_LINK=false

# Optional legacy upload fallback. Firebase Storage is used first when configured.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OPay Checkout
OPAY_PUBLIC_KEY=
OPAY_PRIVATE_KEY=
OPAY_MERCHANT_ID=
OPAY_COUNTRY=NG
OPAY_SANDBOX=true
